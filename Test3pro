-- ============================================================

do
    local AntiKickItemActive = false
    local MyPCLD = nil
    local pcldConn = nil

    local ToyList = {
        ["spray Can"]       = "SprayCanWD",
        ["spooky Candle"]   = "SpookyCandle1",
        ["flying UFO"]      = "FlyingToyUfo",
        ["cup (Brown)"]     = "CupMugBrown",
        ["light (Factory)"] = "FactoryLight",
    }

    local DropdownValues = {}
    for k in pairs(ToyList) do table.insert(DropdownValues, k) end
    table.sort(DropdownValues)
    local SelectedToy = ToyList[DropdownValues[1]]

    DefenseExtra:AddDropdown("AntiKickItemDropdown", {
        Text = "Anti Kick Item",
        Values = DropdownValues,
        Default = "spray Can",
        Callback = function(v) SelectedToy = ToyList[v] end
    })

    local function FindPCLD(hrp)
        if pcldConn then pcldConn:Disconnect() end
        MyPCLD = nil
        pcldConn = RunService.Heartbeat:Connect(function()
            if MyPCLD or not hrp or not hrp.Parent then
                if pcldConn then pcldConn:Disconnect() pcldConn = nil end
                return
            end
            for _, v in pairs(workspace:GetChildren()) do
                if v.Name == "PlayerCharacterLocationDetector" and v:IsA("BasePart") then
                    if (v.Position - hrp.Position).Magnitude <= 2 then
                        MyPCLD = v
                        break
                    end
                end
            end
        end)
    end

    local function sno(part)
        pcall(function()
            RS.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
        end)
    end

    DefenseExtra:AddCheckbox("AntiKickItemFlag", {
        Text = "Anti Kick [ITEM]",
        Default = false,
        Callback = function(Val)
            AntiKickItemActive = Val
            if Val then
                task.spawn(function()
                    while AntiKickItemActive and task.wait() do
                        local char = Player.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if not hrp then continue end
                        if not MyPCLD and not pcldConn then FindPCLD(hrp) end

                        local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                        if not inv then continue end

                        local item = inv:FindFirstChild("AntiKickItem")
                        if not item then
                            task.spawn(function()
                                pcall(function()
                                    RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                                        SelectedToy,
                                        hrp.CFrame * CFrame.new(0, 14, 20),
                                        Vector3.zero
                                    )
                                end)
                            end)
                            task.wait(0.5)
                            inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                            item = inv and inv:FindFirstChild(SelectedToy)
                            if item then
                                item.Name = "AntiKickItem"
                                for _, v in pairs(item:GetChildren()) do
                                    if v:IsA("BasePart") then
                                        v.CanCollide = false
                                        v.Transparency = 0.8
                                    end
                                end
                            end
                        end

                        if item then
                            local hitbox = item:FindFirstChild("Hitbox") or item:FindFirstChildWhichIsA("BasePart")
                            if hitbox then
                                sno(hitbox)
                                hitbox.CFrame = (MyPCLD or hrp).CFrame
                            end
                        end
                    end
                end)
            else
                if pcldConn then pcldConn:Disconnect() pcldConn = nil end
                MyPCLD = nil
                local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                if inv then
                    for _, v in pairs(inv:GetChildren()) do
                        if v.Name == "AntiKickItem" then
                            pcall(function() RS.MenuToys.DestroyToy:FireServer(v) end)
                        end
                    end
                end
            end
        end
    })

    Player.CharacterAdded:Connect(function(char)
        if AntiKickItemActive then
            MyPCLD = nil
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if hrp then FindPCLD(hrp) end
        end
    end)
end

